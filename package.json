{
  "name": "shushang-taoxiang-digital-media-independent",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "数商桃乡数字媒体赛独立站，独立维护和数据库",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "db:migrate": "node --env-file-if-exists=.env server/cli.js migrate",
    "db:seed": "node --env-file-if-exists=.env server/cli.js seed",
    "admin:reset": "node --env-file-if-exists=.env server/cli.js admin-reset",
    "backup": "node --env-file-if-exists=.env server/cli.js backup",
    "restore": "node --env-file-if-exists=.env server/cli.js restore",
    "test": "node --test --test-concurrency=1 tests/*.test.js server/llm.test.js",
    "preview:local": "node scripts/preview-local.mjs",
    "build:compat": "node scripts/build-compat.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "dotenv": "^17.2.3",
    "echarts": "6.1.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "mammoth": "^1.13.0",
    "multer": "^2.0.2",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.16.3",
    "sharp": "^0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "abortcontroller-polyfill": "^1.7.8",
    "acorn": "^8.19.0",
    "autoprefixer": "^10.6.2",
    "core-js": "^3.51.0",
    "dialog-polyfill": "^0.5.6",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.32",
    "postcss-custom-properties": "^15.0.4",
    "postcss-preset-env": "^11.6.1",
    "url-polyfill": "^1.1.14",
    "whatwg-fetch": "^3.6.20"
  }
}
