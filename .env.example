# 本地不设置 DATABASE_URL 时使用 .data/postgres 内的嵌入式 PostgreSQL。
# 生产环境必须设置 Neon 连接串，不能使用本地文件数据库。
DATABASE_URL=
PORT=8787
NODE_ENV=development
APP_URL=http://localhost:8787
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# 首次启动使用，已建账号不会因重启被覆盖。首次登录后修改密码。
ADMIN_EMAIL=admin@taoxiang.local
ADMIN_PASSWORD=
ADMIN_NAME=项目管理员
ANALYTICS_RETENTION_DAYS=180
REQUEST_RETENTION_DAYS=30
BACKUP_DIR=backups
# Render 终止 HTTPS 时设为 1，本地留空
TRUST_PROXY=

# 唯一管理员账号；启用后禁止新增登录成员，协作者使用非登录人员档案。
SINGLE_ADMIN_ACCOUNT=

# 可选服务端模型；密钥仅放环境变量，不提交仓库。
# 主模型仅在服务端配置；六秒未完成或报错即切备用。
PROJECT_AI_API_KEY=
# 备用密钥需单独验证；双失败时回到公开知识规则答复。
DEEPSEEK_API_KEY=
# GLM暂不接入，保持为空，资料使用本地分类与人工复核。
GLM_API_KEY=
AI_SITE_DAILY_LIMIT=300
